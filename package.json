{
  "name": "imacocos",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && tsc -p tsconfig.functions.json && vite build",
    "lint": "oxlint",
    "preview": "vite preview",
    "cf:dev": "npm run build && wrangler pages dev --port 8788",
    "db:create": "wrangler d1 create imacocos-db",
    "db:init:local": "wrangler d1 execute imacocos-db --local --file=./schema.sql",
    "db:init": "wrangler d1 execute imacocos-db --remote --file=./schema.sql",
    "deploy": "npm run build && wrangler pages deploy"
  },
  "dependencies": {
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260810.1",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.4",
    "oxlint": "^1.75.0",
    "typescript": "~6.0.2",
    "vite": "^8.2.0",
    "wrangler": "^4.120.0"
  }
}
