{
  "name": "imacocos",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "npm run map:cards && tsc -b && tsc -p tsconfig.functions.json && vite build && npm run share:pages",
    "lint": "oxlint",
    "preview": "vite preview",
    "cf:dev": "npm run build && wrangler pages dev --port 8788",
    "db:create": "wrangler d1 create imacocos-db",
    "db:init:local": "npm run db:migrate:local",
    "db:init": "npm run db:migrate",
    "db:migrate:local": "wrangler d1 migrations apply imacocos-db --local",
    "db:migrate": "wrangler d1 migrations apply imacocos-db --remote",
    "map:optimize": "node scripts/optimize-map.mjs",
    "map:cards": "node scripts/generate-map-cards.mjs",
    "share:pages": "node scripts/generate-share-pages.mjs",
    "deploy": "npm run build && wrangler pages deploy"
  },
  "dependencies": {
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260810.1",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.4",
    "oxlint": "^1.75.0",
    "sharp": "^0.35.3",
    "typescript": "~6.0.2",
    "vite": "^8.2.0",
    "wrangler": "^4.120.0"
  }
}
